# Настройки подключения к LLM API
# Сервис поддерживает любые OpenAI-совместимые API (OpenAI, Groq, OpenRouter, Ollama, YandexGPT)
# Если ключ не указан, сервис автоматически работает во встроенном детерминированном офлайн-режиме

# Вариант 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Вариант 2: Groq (сверхбыстрый инференс Llama 3)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Вариант 3: Локальная модель Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# Сетевые параметры веб-сервера
PORT=8000
HOST=0.0.0.0
